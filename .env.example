# Safe examples only. Never commit real passwords, tokens, cookies, or keys.
GROWTH_OS_ENV=local
DJANGO_SECRET_KEY=replace-in-local-env-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Set to 1 only when a trusted reverse proxy terminates HTTPS and overwrites
# X-Forwarded-Proto. Leave 0 for direct/local access.
TRUST_PROXY_SSL_HEADER=0

DATABASE_ENGINE=postgresql
POSTGRES_DB=growth_os
POSTGRES_USER=growth_os
POSTGRES_PASSWORD=replace-in-local-env-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

MEDIA_ROOT=/app/media
