# Safe examples only. Never commit real passwords, tokens, cookies, or keys.
GROWTH_OS_ENV=local
# Runtime label shown by /health/. Staging may use staging-candidate until all
# release gates are closed; Production must use production.
GROWTH_OS_DEPLOYMENT_STAGE=local
# Compose build-only input. Replace with the exact 40-character output of
# `git rev-parse HEAD`; never use a branch name, "latest", or a short SHA.
GIT_COMMIT_SHA=replace-with-full-output-of-git-rev-parse-head
# Local-only minimum for newly set/changed test passwords. Never reuse or
# promote this local database into Staging/Production; those environments must
# set PASSWORD_MIN_LENGTH=12 or higher and provision identities separately.
PASSWORD_MIN_LENGTH=6
# Staging identity passwords are never normal environment/Compose values.
# provision_staging_staff accepts only temporary read-only Secret files; the
# exact host-to-container mounts are documented in docs/STAGING-RUNBOOK.md.
# Never populate or commit password values here:
# STAGING_OWNER_PASSWORD_FILE=/run/provision/owner
# STAGING_ADMIN_PASSWORD_FILE=/run/provision/admin
# STAGING_OPERATOR_PASSWORD_FILE=/run/provision/operator
# Local may use a direct development-only value. Staging/Production use the
# corresponding read-only secret file instead.
DJANGO_SECRET_KEY=replace-in-local-env-only
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Set to 1 only when a trusted reverse proxy terminates HTTPS and overwrites
# X-Forwarded-Proto. Leave 0 for direct/local access.
TRUST_PROXY_SSL_HEADER=0

DATABASE_ENGINE=postgresql
POSTGRES_DB=growth_os
POSTGRES_USER=growth_os
POSTGRES_PASSWORD=replace-in-local-env-only
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local stores uploads on disk. Staging and Production must explicitly set
# MEDIA_STORAGE_BACKEND=cos and use a private Tencent COS bucket.
MEDIA_STORAGE_BACKEND=filesystem
MEDIA_ROOT=/app/media

# Non-secret COS deployment settings (safe placeholders only):
# TENCENT_COS_BUCKET=replace-with-bucket-name-appid
# TENCENT_COS_REGION=replace-with-region
# Secrets must come from the approved read-only secret mounts. Never put their
# values in this file, Compose, image layers, shell history, or Git.
# TENCENT_COS_SECRET_ID_FILE=/run/secrets/tencent_cos_secret_id
# TENCENT_COS_SECRET_KEY_FILE=/run/secrets/tencent_cos_secret_key
